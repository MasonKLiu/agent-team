{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-2",
  "permissions": {
    "allow": [
      "Bash(python scripts/check_team.py:*)",
      "Bash(python scripts/check_governance.py:*)",
      "Bash(python -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(.governance/baseline.json)",
      "Write(.governance/baseline.json)"
    ]
  }
}
